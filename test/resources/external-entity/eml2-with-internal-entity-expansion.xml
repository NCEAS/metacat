<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE eml:eml [
    <!ELEMENT eml:eml ANY>
    <!ATTLIST eml:eml
        xmlns:xsi CDATA #IMPLIED
        xmlns:eml CDATA #IMPLIED
        xmlns:stmml CDATA #IMPLIED
        packageId CDATA #IMPLIED
        system CDATA #IMPLIED
        scope CDATA #IMPLIED
        xsi:schemaLocation CDATA #IMPLIED
    >

    <!ELEMENT dataset ANY>

    <!ELEMENT title (#PCDATA)>

    <!ELEMENT creator ANY>
    <!ELEMENT individualName ANY>
    <!ELEMENT givenName (#PCDATA)>
    <!ELEMENT surName (#PCDATA)>

    <!ELEMENT contact ANY>
    <!ENTITY lol "lol">
    <!ENTITY lol1 "&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;">
    <!ENTITY lol2 "&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;">
    <!ENTITY lol3 "&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;">

]>
<eml:eml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:eml="https://eml.ecoinformatics.org/eml-2.2.0" xmlns:stmml="http://www.xml-cml.org/schema/stmml-1.2" packageId="eml-test-doc" system="https://arcticdata.io" scope="system" xsi:schemaLocation="https://eml.ecoinformatics.org/eml-2.2.0 eml.xsd">
  <dataset>
    <title>EML Annotation Example</title>
    <creator>
      <individualName>
        <givenName>&lol3;</givenName>
        <surName>Smith</surName>
      </individualName>
    </creator>
    <contact>
            <individualName>
                <givenName>hello</givenName>
                <surName>Smith</surName>
            </individualName>
     </contact>
  </dataset>
</eml:eml>